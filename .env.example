# Copy to .env.local in the webapp root; keep real values out of Git/chat.
# All credentials are server-only. NEVER prefix them with VITE_.

# AI Assistant: OpenAI Platform project API key (Responses API write permission).
# OpenAI API billing is separate from ChatGPT/Codex subscriptions and RunComfy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# RunComfy: shared key for connection checks, still deployment and motion.
RUNCOMFY_API_KEY=
# Enable live generation locally. Prepared media needs no credentials.
CONTENT_STUDIO_LIVE_ENABLED=false
# Explicit false disables new motion submissions, not saved private playback.
CONTENT_STUDIO_MOTION_ENABLED=true

# Live stills: Krea 2 Turbo with the registered RAW-trained LoRA via Models API.
CONTENT_STUDIO_STILL_BACKEND=krea
# Optional: retained only for recovering historical FLUX jobs.
RUNCOMFY_DEPLOYMENT_ID=

# Vercel Blob: public source-image hosting (not a Vercel account access token).
# Store -> Quickstart -> .env.local. Public URLs are accessible to anyone with them.
# Upload/register the reference collection with: node scripts/host-references.mjs
BLOB_READ_WRITE_TOKEN=

# Optional reviewer password. Blank permits explicit loopback-owner authorization.
CONTENT_STUDIO_REVIEWER_TOKEN=

# Private local durable job/result storage. Never use public/ or commit these.
CONTENT_STUDIO_DATA_DIR=.local-data/stills
CONTENT_STUDIO_MOTION_DATA_DIR=.local-data/motion

# Legacy temporary Comfy settings; not used for new Krea submissions.
RUNCOMFY_COMFY_URL=
# ISO-8601 expiry matching the actual temporary session.
RUNCOMFY_COMFY_EXPIRES_AT=

# Optional FFprobe path; otherwise the server looks on PATH.
# CONTENT_STUDIO_FFPROBE_PATH=C:/path/to/ffprobe.exe

# No application job-count or dollar allowance. Old *_BUDGET_USD,
# *_MAX_JOBS, *_JOB_RESERVE_USD and *_MAX_JOB_USD settings are obsolete.
# Provider billing/limits still apply. Confirmation, authorization,
# concurrency, request spacing and duplicate/recovery protection remain.
